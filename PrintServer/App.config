<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Configurações HTTP do Print Server API - CONFIGURAR COM SEU IP E PORTA -->
        <add key="PrintServerIp" value="" />
        <add key="PrintServerPort" value="" />
        
        <!-- Configurações para Impressora Serial -->
        <add key="PrinterPortName" value="COM2" />
        <add key="PrinterBaudRate" value="9600" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
